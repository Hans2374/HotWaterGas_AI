# =============================================================================
# HotWaterGas AI Service — Environment Configuration (EXAMPLE)
# =============================================================================
# Copy this file to `.env` and replace placeholders with your real values.
# NEVER commit a populated `.env` to version control. The `.gitignore` in
# this directory already excludes it.
# =============================================================================

# ── Application ────────────────────────────────────────────────────────────
# Allowed values: "development" | "staging" | "production"
APP_ENV=development

# ── AI generation switch ───────────────────────────────────────────────────
# Hard master switch for description generation. Must be "true" or "false".
# Defaults to "false" so the service starts safely without any provider key.
# When false, every generation route returns HTTP 503 with
# code "generation_disabled".
AI_GENERATION_ENABLED=false

# ── Provider selection ─────────────────────────────────────────────────────
# Which LLM backend serves generation requests.
#   "ollama" — local, free, offline. The only implemented backend, and the
#              development and test default.
#   "gemini" — a legacy value that is still accepted so an existing
#              deployment's setting stays parseable. That backend was
#              removed with the Gemini-backed pipeline, so selecting it fails closed
#              with HTTP 503 / code "provider_not_configured".
# There is NO automatic fallback between providers. A failing provider is
# surfaced as a controlled HTTP error; the service never silently
# switches models or backends.
LLM_PROVIDER=ollama

# ── Ollama provider (local, free — no paid API) ───────────────────────────
# Base URL of the local Ollama HTTP API. Keep this on loopback: the
# service must never reach a public Ollama endpoint, and Ollama itself
# must never be bound to a public interface.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# The local model id. qwen3:8b is the current local model. The service
# never silently falls back to a different model: an unknown id surfaces
# as HTTP 502 with code "provider_model_not_found".
OLLAMA_MODEL_ID=qwen3:8b

# Per-request timeout, in seconds. Local CPU inference is slow (qwen3:8b
# emits reasoning tokens before its answer), so the default is generous.
# Range: 1–600.
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# TCP connection timeout, in seconds. Kept short so a stopped Ollama
# server fails fast instead of hanging. Range: 1–60.
OLLAMA_CONNECT_TIMEOUT_SECONDS=5

# Timeout for the /api/tags model-availability probe, in seconds. The
# probe result is cached, so it is not paid on every request.
# Range: 1–60.
OLLAMA_TAGS_TIMEOUT_SECONDS=10

# Upper bound on tokens generated by a single Ollama call. Sized for a
# translation call including reasoning tokens.
OLLAMA_NUM_PREDICT=2048

# Sampling temperature. Kept low so the translations are close to
# deterministic. Range: 0.0–2.0.
OLLAMA_TEMPERATURE=0.2

# ── Steam retrieval (optional enrichment) ─────────────────────────────────
# Master switch for the optional Steam retrieval behind the translation
# route and the Steam Store Search route.
# When false, a translation request that carries a steam_app_id is still
# accepted but NO Steam request is made, and the Steam Store Search route
# answers HTTP 503 with code "steam_search_disabled".
# Defaults to false so the service never reaches out to Steam unless the
# operator explicitly opts in.
STEAM_RETRIEVAL_ENABLED=false

# TCP connection timeout for the Steam request, in seconds. Kept short so
# an unreachable host fails fast. Range: >0–60.
STEAM_CONNECT_TIMEOUT_SECONDS=5

# Read timeout for the Steam request, in seconds. Kept well below the
# Ollama budget so Steam can never dominate the request latency.
# Range: >0–120.
STEAM_READ_TIMEOUT_SECONDS=10

# Maximum number of bytes read from the Steam endpoint. The body is
# counted while it is read, so an oversized response is aborted instead of
# buffered. Range: 1024–8388608.
STEAM_MAX_RESPONSE_BYTES=524288

# ── Internal service auth ──────────────────────────────────────────────────
# Shared secret presented by ASP.NET Core via the X-Internal-Token header.
# When this value is empty the service fails closed: any request to an
# /internal/* route returns HTTP 500 with code "internal_token_not_configured".
# The token MUST be set in every environment that will enable generation.
# Generate a strong random value per environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Token values are restricted to ASCII characters (RFC 7230).
INTERNAL_SERVICE_TOKEN=replace-with-a-strong-random-ascii-secret-per-environment
